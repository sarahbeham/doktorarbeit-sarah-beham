<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/sea_green</item>
        <item name="colorPrimaryVariant">@color/light_sea_green</item>
        <item name="colorOnPrimary">@color/white_isabelline</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/sea_green</item>
        <item name="colorSecondaryVariant">@color/light_sea_green</item>
        <item name="colorOnSecondary">@color/white_isabelline</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Other customizations -->
        <item name="android:windowBackground">@color/white_isabelline</item>
    </style>

    <style name="SwitchCompatStyle" >
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="trackTint">@color/light_sea_green</item>
    </style>
</resources>
